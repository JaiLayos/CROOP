<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/resto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/beige_brackground">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:id="@+id/headerCard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardBackgroundColor="@color/beige_brackground">

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/backFloat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="30dp"
                    android:layout_marginTop="80dp"
                    android:clickable="true"
                    android:contentDescription="back"
                    app:backgroundTint="@color/highlight_green"
                    app:srcCompat="@drawable/back" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/formCard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardBackgroundColor="@color/beige_brackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/addTableLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="50dp"
                        android:layout_marginEnd="20dp"
                        android:fontFamily="@font/inter_semibold"
                        android:text="@string/adding_product"
                        android:textAlignment="center"
                        android:textSize="42sp" />

                    <TextView
                        android:id="@+id/addDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:text="@string/input_details_of_product_here"
                        android:textAlignment="center"
                        android:textSize="16sp" />

                    <ImageView
                        android:id="@+id/addProductProfile"
                        android:layout_width="wrap_content"
                        android:layout_height="250dp"
                        android:layout_marginTop="20dp"
                        android:scaleType="centerCrop"
                        app:srcCompat="@drawable/logo" />

                    <Button
                        android:id="@+id/uploadPicButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginEnd="20dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/secondary_color"
                        android:text="UPLOAD PICTURE"
                        android:textAlignment="center"
                        android:textSize="20sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="50dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/nameLabel"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:fontFamily="@font/mulish_medium"
                            android:paddingStart="20dp"
                            android:text="@string/item_name"
                            android:textSize="20sp" />

                        <EditText
                            android:id="@+id/nameText"
                            android:layout_width="0dp"
                            android:layout_height="55dp"
                            android:layout_marginEnd="20dp"
                            android:layout_weight="1"
                            android:background="@drawable/rounded_border_edit_text"
                            android:ems="10"
                            android:hint="Hal. Mangga"
                            android:inputType="text"
                            android:paddingStart="10dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="20dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/initialLabel"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:fontFamily="@font/mulish_medium"
                            android:paddingStart="20dp"
                            android:text="@string/item_quantitiy"
                            android:textSize="20sp" />

                        <EditText
                            android:id="@+id/initialText"
                            android:layout_width="0dp"
                            android:layout_height="55dp"
                            android:layout_marginEnd="20dp"
                            android:layout_weight="1"
                            android:background="@drawable/rounded_border_edit_text"
                            android:ems="10"
                            android:hint="Hal. 10"
                            android:inputType="text"
                            android:paddingStart="10dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="20dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/unitLabel"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:fontFamily="@font/mulish_medium"
                            android:paddingStart="20dp"
                            android:text="Yunit"
                            android:textSize="20sp" />

                        <Spinner
                            android:id="@+id/unitOptions"
                            android:layout_width="0dp"
                            android:layout_height="55dp"
                            android:layout_marginEnd="20dp"
                            android:layout_weight="1" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="20dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/priceLabel"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:fontFamily="@font/mulish_medium"
                            android:paddingStart="20dp"
                            android:paddingEnd="10dp"
                            android:text="Presyo pagbinenta"
                            android:textSize="20sp" />

                        <EditText
                            android:id="@+id/priceText"
                            android:layout_width="0dp"
                            android:layout_height="55dp"
                            android:layout_marginEnd="20dp"
                            android:layout_weight="1"
                            android:background="@drawable/rounded_border_edit_text"
                            android:ems="10"
                            android:hint="Hal. 1205"
                            android:inputType="text"
                            android:paddingStart="10dp" />

                    </LinearLayout>

                    <View
                        android:id="@+id/divider6"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="50dp"
                        android:background="?android:attr/listDivider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/freshnessLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/mulish_medium"
                            android:paddingStart="20dp"
                            android:paddingEnd="10dp"
                            android:text="Ilang araw sariwa ang produkto?"
                            android:textSize="20sp" />

                        <EditText
                            android:id="@+id/freshnessText"
                            android:layout_width="0dp"
                            android:layout_height="55dp"
                            android:layout_marginTop="15dp"
                            android:layout_marginEnd="20dp"
                            android:layout_weight="1"
                            android:background="@drawable/rounded_border_edit_text"
                            android:ems="10"
                            android:hint="Hal. 1205"
                            android:inputType="text"
                            android:paddingStart="10dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="20dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/restockLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/mulish_medium"
                            android:paddingStart="20dp"
                            android:paddingEnd="10dp"
                            android:text="Ilang araw ang tinatayang aabutin bago muling tumubo at ma-restock ang produkto?"
                            android:textSize="20sp" />

                        <EditText
                            android:id="@+id/restockText"
                            android:layout_width="0dp"
                            android:layout_height="55dp"
                            android:layout_marginTop="15dp"
                            android:layout_marginEnd="20dp"
                            android:layout_weight="1"
                            android:background="@drawable/rounded_border_edit_text"
                            android:ems="10"
                            android:hint="Hal. 1205"
                            android:inputType="text"
                            android:paddingStart="10dp" />

                    </LinearLayout>

                    <Button
                        android:id="@+id/addButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="50dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="80dp"
                        android:backgroundTint="@color/secondary_color"
                        android:fontFamily="@font/inter_semibold"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:text="@string/add"
                        android:textSize="20sp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>