<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/secondary_color"
            app:layout_scrollFlags="scroll|enterAlways">

            <TextView
                android:id="@+id/greetingsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:paddingTop="10dp"
                android:text="WELCOME!"
                android:textColor="@color/beige_brackground" />

        </androidx.appcompat.widget.Toolbar>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:backgroundTint="@color/beige_brackground"
            app:tabMode="scrollable">

            <com.google.android.material.tabs.TabItem
                android:id="@+id/homeTab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home" />

            <com.google.android.material.tabs.TabItem
                android:id="@+id/productTab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Products" />

            <com.google.android.material.tabs.TabItem
                android:id="@+id/sellersTab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sellers" />

            <com.google.android.material.tabs.TabItem
                android:id="@+id/cartTab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cart" />

            <com.google.android.material.tabs.TabItem
                android:id="@+id/profileTab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile" />

            <com.google.android.material.tabs.TabItem
                android:id="@+id/accountTab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Account" />

        </com.google.android.material.tabs.TabLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>