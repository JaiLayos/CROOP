<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/secondary_color">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" >

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="70dp"
                app:cardBackgroundColor="@color/secondary_color">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <TableLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingStart="20dp"
                        android:stretchColumns="1">

                        <TableRow
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <TextView
                                android:id="@+id/nameLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/mulish_medium"
                                android:text="@string/item_name"
                                android:textAlignment="textEnd"
                                android:textColor="@color/beige_brackground"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/nameText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/mulish_medium"
                                android:paddingStart="10dp"
                                android:paddingTop="10dp"
                                android:paddingBottom="20dp"
                                android:text="TextView"
                                android:textColor="@color/highlight_green"
                                android:textSize="20sp" />

                        </TableRow>

                        <TableRow
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" >

                            <TextView
                                android:id="@+id/priceLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/mulish_medium"
                                android:text="Price"
                                android:textAlignment="textEnd"
                                android:textColor="@color/beige_brackground"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/priceText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/mulish_medium"
                                android:paddingStart="10dp"
                                android:paddingTop="10dp"
                                android:paddingBottom="20dp"
                                android:text="TextView"
                                android:textColor="@color/highlight_green"
                                android:textSize="20sp" />
                        </TableRow>

                        <TableRow
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" >

                            <TextView
                                android:id="@+id/discountLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/mulish_medium"
                                android:text="Discount"
                                android:textAlignment="textEnd"
                                android:textColor="@color/beige_brackground"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/discountText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/mulish_medium"
                                android:paddingStart="10dp"
                                android:paddingTop="10dp"
                                android:paddingBottom="20dp"
                                android:text="TextView"
                                android:textColor="@color/highlight_green"
                                android:textSize="20sp" />
                        </TableRow>

                        <TableRow
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" >

                            <TextView
                                android:id="@+id/saleLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/mulish_medium"
                                android:text="Sale Price"
                                android:textAlignment="textEnd"
                                android:textColor="@color/beige_brackground"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/saleText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/mulish_medium"
                                android:paddingStart="10dp"
                                android:paddingTop="10dp"
                                android:paddingBottom="20dp"
                                android:text="TextView"
                                android:textColor="@color/highlight_green"
                                android:textSize="20sp" />
                        </TableRow>

                        <TableRow
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <TextView
                                android:id="@+id/sellerLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/mulish_medium"
                                android:text="Seller"
                                android:textAlignment="textEnd"
                                android:textColor="@color/beige_brackground"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/sellerText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/mulish_medium"
                                android:paddingStart="10dp"
                                android:paddingTop="10dp"
                                android:paddingBottom="20dp"
                                android:text="TextView"
                                android:textColor="@color/highlight_green"
                                android:textSize="20sp" />
                        </TableRow>

                    </TableLayout>

                    <Button
                        android:id="@+id/seeProductButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="50dp"
                        android:layout_marginEnd="20dp"
                        android:backgroundTint="@color/highlight_green"
                        android:fontFamily="@font/inter_semibold"
                        android:text="SEE PRODUCT"
                        android:textSize="20sp" />

                    <Button
                        android:id="@+id/seeSellerButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="20dp"
                        android:backgroundTint="@color/highlight_green"
                        android:fontFamily="@font/inter_semibold"
                        android:text="SEE SELLER"
                        android:textSize="20sp" />

                    <Button
                        android:id="@+id/closeButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginBottom="60dp"
                        android:backgroundTint="@color/highlight_green"
                        android:fontFamily="@font/inter_semibold"
                        android:text="CLOSE"
                        android:textSize="20sp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>